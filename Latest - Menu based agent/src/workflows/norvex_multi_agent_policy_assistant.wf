        {
          "id": "1787089241813",
          "code": "CAREER_AGENT_CALL",
          "type": "AGENT",
          "metadata": {
            "description": "Answers employee questions on Confirmation, Transfer, India Relocation, PIP, and Performance Appraisal & Promotion policy",
            "name": "Career Agent Call",
