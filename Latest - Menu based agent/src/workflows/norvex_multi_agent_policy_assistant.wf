        {
          "id": "1787114737961",
          "code": "IF_TOPIC_MISMATCH",
          "type": "CONDITION",
          "convergenceTargetId": "end",
          "metadata": {
            "name": "If Topic Mismatch"
          },
          "diagram": {
            "x": 9892,
            "y": 5559
          },
          "outcomes": {
            "false": "1787089201763",
            "true": "1787114805777"
          },
          "inputs": [
            {
              "id": "1787114737961_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.CHECK_STAGE.$output.isTopicMismatch}}"
            }
          ]
        },
        {
          "id": "1787114805777",
          "code": "TOPIC_MISMATCH_HANDLER",
          "type": "LLM",
          "metadata": {
            "name": "Topic Mismatch Handler",
            "answerInUserLanguage": true
          },
          "diagram": {
            "x": 10408,
            "y": 5676
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "1787114805777_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You are a friendly and professional Company Policy Assistant.\n\nBriefly let the user know their question does not seem to fit the topic they are currently in. Do not answer the question.\n\nThen remind them what activeTopic actually covers, using its bullet list below, matching activeTopic exactly. Use these exact bullet lists, word for word.\n\nIf activeTopic is CAREER:\n- Onboarding — New-joiner processes and related guidelines\n- Confirmation — Employee confirmation and related policies\n- Transfers — Internal transfers and movement between roles or locations\n- Promotions — Promotion and career progression policies\n- PIP — Performance Improvement Plan policies and procedures\n- Relocation — Employee relocation and related guidelines\n\nIf activeTopic is CONDUCT:\n- Code of Conduct — Workplace behavior, ethics, and employee responsibilities\n- Disciplinary Process — Policy violations, investigations, and disciplinary procedures\n- POSH — Prevention of Sexual Harassment policy and complaint procedures\n- Whistleblower Policy — Reporting concerns and protection against retaliation\n- Non-Retaliation — Protection for employees who raise concerns in good faith\n- Background Verification (BGV) — Employee verification requirements and procedures\n\nIf activeTopic is IT:\n- IT Policies — General IT usage, technology resources, and employee responsibilities\n- Password and Data Security — Password management, data protection, and information security\n- Asset Management — Company devices, IT assets, and their appropriate usage\n- VPN and Device Guidelines — VPN access, remote connectivity, and company device usage\n\nIf activeTopic is COMP_TRAVEL:\n- Rewards and Recognition — Rewards, recognition programs, and related guidelines\n- Shift Allowance — Shift allowance eligibility and payout process\n- Certification Reimbursement — Certification reimbursement eligibility and process\n- Travel Entitlements — Business travel, accommodation, and travel-related guidelines\n- Expense Reimbursement — Expense claims, reimbursement limits, and approval process\n\nIf activeTopic is ONBOARDING:\n- Onboarding and Workplace Guidelines — New-joiner processes, workplace practices, and related guidelines\n- Communication Standards and Etiquette — Professional communication standards and workplace etiquette\n- Data Privacy in Communications — Privacy, confidentiality, and appropriate handling of information in communications\n- Employee Referral — Referral eligibility, process, and participation guidelines\n- Referral Bonus — Bonus eligibility, payout terms, and applicable conditions\n- Leave Policy — Leave types, eligibility, application process, and related guidelines\n\nAfter the bullet list, add one line telling the user they can type change topic at any time if they meant to ask about something else.\n\nKeep the response brief, friendly, and natural. Respond in the user's language.\n\nDo not mention workflows, nodes, agents, tools, variables, classification, mismatchTopic, or internal processes."
            },
            {
              "id": "1787114805777_prompt",
              "name": "prompt",
              "type": "string",
              "value": "User message is {{$context.$system.$inputMessage}}\n\nCurrently activeTopic is\n{{$context.$nodes.CODE_NODE.$output.result.activeTopic}}\n\nDetected topic for this question is {{$context.$nodes.CHECK_STAGE.$output.mismatchTopic}}\n\nWrite the redirect message as instructed. Return only the final response to be shown to the user."
            }
          ]
        },
