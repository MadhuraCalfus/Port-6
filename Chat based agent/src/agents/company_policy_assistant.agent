        "name": "Company Policy Knowledge Base",
        "description": "Provides access to company policy documents including leave, attendance, work from home, travel and expense, and employee code of conduct policies. Use this tool to retrieve information from the policy documents when answering employee questions.",
        "type": "DOCUMENT",
        "family": "HCM",
        "product": "GLOBAL_HUMAN_RESOURCES",
        "seededFlag": false,
        "userInputRequiredFlag": false,
        "specification": {
          "customFlag": false,
          "jsonSchemaName": "Tool.spec",
          "jsonSchemaVersion": "1",
          "ragDocumentMetadata": {
            "authorization": {},
            "content": {},
            "contentArray": []
          }
        }
      }
    }
  ],
  "agentTopicMappings": []
}
