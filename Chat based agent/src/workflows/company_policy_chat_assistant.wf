              "type": "string"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"answer\": {\n      \"type\": \"string\",\n      \"description\": \"A clear, concise, and accurate answer to the user's question based only on information retrieved from the Company Policy Knowledge Base.\"\n    },\n    \"sources\": {\n      \"type\": \"array\",\n      \"description\": \"The specific policy documents supporting the answer. Each source must contain the document name. Include section information inside the same source object when explicitly available in the retrieved document.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"documentName\": {\n            \"type\": \"string\",\n            \"description\": \"The exact name of the source policy document.\"\n          },\n          \"section\": {\n            \"type\": \"string\",\n            \"description\": \"The exact section number and/or section title explicitly associated with the retrieved content. Preserve the original wording and numbering exactly. Do not invent or infer section information.\"\n          },\n          \"page\": {\n            \"type\": \"string\",\n            \"description\": \"Page number or page reference only when explicitly available in the retrieved source.\"\n          },\n          \"heading\": {\n            \"type\": \"string\",\n            \"description\": \"Relevant heading only when explicitly available in the retrieved source.\"\n          },\n          \"chapter\": {\n            \"type\": \"string\",\n            \"description\": \"Chapter number and/or chapter name only when explicitly available in the retrieved source.\"\n          },\n          \"table\": {\n            \"type\": \"string\",\n            \"description\": \"Table number and/or table name only when explicitly available in the retrieved source.\"\n          },\n          \"clause\": {\n            \"type\": \"string\",\n            \"description\": \"Clause number only when explicitly available in the retrieved source.\"\n          },\n          \"appendix\": {\n            \"type\": \"string\",\n            \"description\": \"Appendix number or name only when explicitly available in the retrieved source.\"\n          },\n          \"sourceIdentifier\": {\n            \"type\": \"string\",\n            \"description\": \"URL, document identifier, or other source identifier only when explicitly available in the retrieved source.\"\n          }\n        },\n        \"required\": [\n          \"documentName\"\n        ]\n      }\n    },\n    \"follow_up_options\": {\n      \"type\": \"array\",\n      \"minItems\": 3,\n      \"maxItems\": 3,\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Exactly 3 dynamically generated follow-up questions related to the current policy topic. The questions must be based only on information available in the Company Policy Knowledge Base and must not repeat the user's original question.\"\n    }\n  },\n  \"required\": [\n    \"answer\",\n    \"sources\",\n    \"follow_up_options\"\n  ]\n}"
        },
